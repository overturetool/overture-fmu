<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.overturetool.fmi</groupId>
        <artifactId>root</artifactId>
        <version>${revision}${sha1}${changelist}</version>
        <relativePath>../pom.xml</relativePath>
    </parent>


    <groupId>org.overturetool.fmi.fmu</groupId>
    <artifactId>vdmfmu</artifactId>
    <name>VDM Fmu interpreter integration</name>

    <properties>
        <vdmj.version>4.7.0</vdmj.version>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.overturetool.fmi</groupId>
            <artifactId>unifmu-runtime</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Source: https://mvnrepository.com/artifact/dk.au.ece.vdmj/vdmj -->
        <dependency>
            <groupId>dk.au.ece.vdmj</groupId>
            <artifactId>vdmj</artifactId>
            <version>${vdmj.version}</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>dk.au.ece.vdmj</groupId>
            <artifactId>stdlib</artifactId>
            <version>${vdmj.version}</version>
            <scope>compile</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>6.1.3</version>
            <scope>test</scope>
        </dependency>


        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-api</artifactId>
            <version>2.25.2</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.25.2</version>
        </dependency>
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-slf4j2-impl</artifactId>
            <version>2.25.2</version>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.17</version>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>unifmu/**</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>../unifmu-runtime/target/generated-fmu/binaries</directory>
                <targetPath>unifmu/binaries</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>stage-generated-runtime</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <delete dir="${project.build.directory}/runtime-libs"/>
                                <!-- Reactor test builds expose this dependency as classes, so stage the generated JAR directly. -->
                                <copy file="${project.basedir}/../unifmu-runtime/target/generated-fmu/resources/libs/unifmu-java-runtime-${unifmu.version}.jar"
                                      todir="${project.build.directory}/runtime-libs"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>stage-runtime-dependencies</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>runtime</includeScope>
                            <excludeArtifactIds>unifmu-runtime</excludeArtifactIds>
                            <outputDirectory>${project.build.directory}/runtime-libs</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                            <mainClass>org.overturetool.fmi.fmu.unifmu.FmuPacker</mainClass>
                        </manifest>
                    </archive>
                    <descriptorRefs>
                        <descriptorRef>jar-with-dependencies</descriptorRef>
                    </descriptorRefs>
                </configuration>
                <executions>
                    <execution>
                        <id>make-my-jar-with-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>make-local-runtime-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                        <configuration>
                            <finalName>${project.artifactId}</finalName>
                            <attach>false</attach>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>intellij-unifmu-runtime</id>
            <activation>
                <property>
                    <name>idea.version</name>
                </property>
            </activation>
            <dependencies>
                <!-- IntelliJ cannot index library classes extracted into another module's output directory. -->
                <dependency>
                    <groupId>org.intocps.unifmu</groupId>
                    <artifactId>unifmu-java-runtime</artifactId>
                    <version>${unifmu.version}</version>
                    <scope>system</scope>
                    <systemPath>${project.basedir}/../unifmu-runtime/target/generated-fmu/resources/libs/unifmu-java-runtime-${unifmu.version}.jar</systemPath>
                </dependency>
            </dependencies>
        </profile>
    </profiles>

</project>
