class RealPort
instance variables
    value : real := 0.0;
operations
    public RealPort : real ==> RealPort
    RealPort(v) == value := v;
    public setValue : real ==> ()
    setValue(v) == value := v;
    public getValue : () ==> real
    getValue() == return value;
end RealPort

class IntPort
instance variables
    value : int := 0;
operations
    public IntPort : int ==> IntPort
    IntPort(v) == value := v;
    public setValue : int ==> ()
    setValue(v) == value := v;
    public getValue : () ==> int
    getValue() == return value;
end IntPort

class BoolPort
instance variables
