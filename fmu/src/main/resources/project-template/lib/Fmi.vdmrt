operations
    public BoolPort : bool ==> BoolPort
    BoolPort(v) == value := v;
    public setValue : bool ==> ()
    setValue(v) == value := v;
    public getValue : () ==> bool
    getValue() == return value;
end BoolPort

class StringPort
instance variables
    value : seq of char := "";
operations
    public StringPort : seq of char ==> StringPort
    StringPort(v) == value := v;
    public setValue : seq of char ==> ()
    setValue(v) == value := v;
    public getValue : () ==> seq of char
    getValue() == return value;
